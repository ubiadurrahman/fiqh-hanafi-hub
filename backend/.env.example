# Copy to .env and fill in. NEVER commit .env.
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/fiqh_hub?schema=public"

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=2h

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 for local dev, 1 behind nginx/Render/etc.)
TRUST_PROXY=0

# Used ONLY by `npm run setup-admin` (password must be strong; remove after use)
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
